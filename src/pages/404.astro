---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — PSS Powers"
  description="The page you are looking for does not exist."
  noPopup={true}
>
  <main class="pt-20">
    <section class="py-24 md:py-36">
      <div class="max-w-2xl mx-auto px-6 text-center" data-aos="fade-up">
        <p class="text-emerald-400 text-sm font-semibold tracking-widest uppercase mb-4">404</p>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white tracking-tight mb-5">
          Page not found.
        </h1>
        <p class="text-slate-400 text-lg leading-relaxed mb-8">
          The page you are looking for doesn't exist or has been moved.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/"
            class="inline-flex items-center justify-center px-8 py-3.5 bg-emerald-500 hover:bg-emerald-600 transition-colors text-slate-950 font-bold rounded-full text-base"
          >
            Back to home
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors text-white font-semibold rounded-full text-base"
          >
            Contact us
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
