---
import Layout from '../layouts/Layout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import PosterModal from '../components/PosterModal.astro';

const heroImage = '/Commitment Day/CD 26 Opening Dry Ice.jpg';

const keynotes = [
  {
    name: 'Khun Somchai Songsiri',
    role: 'Deputy Governor, PEA',
  },
  {
    name: 'Khun Arthit Vechakij',
    role: 'President, Thai RE100 Association',
  },
  {
    name: 'Khun Vibeke Lyssand Leirvag',
    role: 'Chairwoman, JFCCT',
  },
];

const sessions = [
  {
    id: 'session-1',
    track: 'Gov & Policy',
    title: 'Is it a real boom? Can Thailand power the AI and data-centre boom?',
    summary:
      'A single 100 MW data-centre campus draws power on the scale of a Thai city. Can the grid, connection timelines and policy support growth at the speed now being proposed?',
    moderator: 'Bob Fox — JFCCT',
    panel: [
      { org: 'ERC', person: 'Dr. Chanchai Amornvipas, Director' },
      { org: 'ERRA', person: 'M.K. Balaji' },
      { org: 'Thammasat University', person: 'Prof. Nondh Nuchmorn' },
      { org: 'Deloitte', person: 'Dr. Bordin Vongvitayapirom' },
    ],
    faceImage: '/Commitment Day/5.1.1_-_Panel__Leader_+_Government_.png',
    posterImage: '/Commitment Day/5.1_-_Panel__Leader_+_Government_.jpg',
  },
  {
    id: 'session-2',
    track: 'Invest Now — Quick Wins',
    title: 'What can companies implement today?',
    summary:
      'BESS and peak management, industrial efficiency, cooling, energy recovery and practical renewables. Real projects, real economics, real payback periods.',
    moderator: 'Natagorn Kawsuay — Head of Business Development & Strategic Partnerships, PSS Powers',
    panel: [
      { org: 'EEC Engineering Network', person: 'Annop Kingkachee' },
      { org: 'Huawei Thailand', person: 'Patipan Kalvibool' },
      { org: 'The Perfect Seals and Services', person: 'Karan Yamdagni' },
    ],
    faceImage: '/Commitment Day/5.2.1_-_Panel__Quick_Win_Technology_.png',
    posterImage: '/Commitment Day/5.2_-_Panel__Quick_Win_Technology_.jpg',
  },
  {
    id: 'session-3',
    track: 'DC in 12 Months — EPC, Engg & Consult',
    title: 'Can we build a data center in 12 months?',
    summary:
      'Projects are expected to move from concept to operational readiness inside a year — while managing design changes, long-lead equipment, testing and commissioning.',
    moderator: 'Bob Fox — JFCCT',
    panel: [
      { org: 'Meinhardt Thailand', person: 'Matthew Silvester' },
      { org: 'JLL', person: 'Chailai van Kampen' },
      { org: 'PCS Thailand', person: 'Ibrahim Kocagoz' },
    ],
    faceImage: '/Commitment Day/5.3.1_-_Panel__Engg_+_EPC_+_Consult_.png',
    posterImage: '/Commitment Day/5.3_-_Panel__Engg_+_EPC_+_Consult_.jpg',
  },
  {
    id: 'session-4',
    track: 'Big Strategies — Vision 2036',
    title: 'Where should Thailand invest now?',
    summary:
      'Grid modernisation, generation and storage, LNG and fuel security, transport decarbonisation. Capital and time are limited — this panel prioritised, on the record.',
    moderator: 'Martin Venzky-Stalling — JFCCT',
    panel: [
      { org: 'Prince of Songkla University', person: 'Assoc. Prof. Prawit Kongjan' },
      { org: 'Maxion Wheels / EVAT', person: 'Sutheep Ratnabhas' },
      { org: 'UNESCAP', person: 'Zixuan Guo' },
      { org: 'Siemens Energy', person: 'Natat Thinaphong' },
      { org: 'Krungthai Bank', person: 'Kriengkrai Chokelarptawee' },
    ],
    faceImage: '/Commitment Day/5.4.1_-_Panel__Strategic_Initiative_.png',
    posterImage: '/Commitment Day/5.4_-_Panel__Strategic_Initiative_.jpg',
  },
];

const techUpdate = {
  faceImage: '/Commitment Day/5.5.1_-_7_Mins_Tech_Update_.png',
  posterImage: '/Commitment Day/5.5_-_7_Mins_Tech_Update_.png',
  companies: ['Huawei', 'Integra RE', 'Atmoce', 'Jinko Solar', 'Envision', 'PSS', 'Istari'],
};

const quoteTabs = [
  {
    id: 'data-centres',
    label: 'Data Centres',
    quotes: [
      {
        text: 'There is money to invest, but money wants time to market, policies have to be known and clear, their clarity has to support quantifiable construction. It\u2019s quite normal that money is attracted to policy clarity, cost effectiveness and predictable returns.',
        author: 'Matthew Silvester',
        role: 'Director, Meinhardt Thailand',
      },
      {
        text: 'The Direct PPA 2,000 MW pilot, originally proposed in 2004, is not likely to be finalized until early 2027.',
        author: 'Dr. Chanchai Amornvipas',
        role: 'Director, Energy Regulatory Development and Strategic Execution Dept., ERC',
      },
      {
        text: 'The Power Development Plan will need to both support and harmonise with energy policy.',
        author: 'M.K. Balaji',
        role: 'Strategic Advisory Board, ERRA',
      },
      {
        text: 'Looking beyond PPAs, there may come a time when they are not the exception, but a decentralised market with direct supply is the norm.',
        author: 'Lucas Meier',
        role: 'Program Manager, CPG (German\u2013Southeast Asian Centre of Excellence for Public Policy and Good Governance)',
      },
      {
        text: 'We will factor in all scenarios. Unknowns just mean more complexity and costs in planning.',
        author: 'Chalalai van Kampen',
        role: 'Head of Cost Management (Data Centres, Industrial & Logistics), JLL',
      },
      {
        text: 'PREDICTABLE ENERGY includes availability, cost and confidence in transformation to higher renewables demand, and a decentralised sector away from a traditional monopoly.',
        author: 'Consensus from Data Centres panels',
        role: '',
        featured: true,
      },
      {
        text: 'It comes at us at high velocity in flashing red neon: In this time of rapid development where the game has already changed, cogent policy clarity is fundamental to Thailand\u2019s Data Centre success. There are now several policy makers.',
        author: 'Bob Fox',
        role: 'Moderator of two Data Centre panels (Policy, Constructor)',
      },
      {
        text: 'UGT2 has price stability \u2014 decoupled from fossil prices; REC price embedded.',
        author: 'Dr. Chanchai Amornvipas',
        role: 'Director, Energy Regulatory Development and Strategic Execution Dept., ERC',
      },
      {
        text: 'Prior to 2025, colocation data centres dominated the market. However, the trend has shifted towards hyperscalers. The Eastern Economic Corridor (EEC) is one of the prime locations for large-scale infrastructure, while locations near Bangkok\u2019s CBA are in high demand for colocations.',
        author: 'Chalalai van Kampen',
        role: 'Head of Cost Management (Data Centres, Industrial & Logistics), JLL',
      },
      {
        text: 'Capacity is adequate in aggregate. The issue is where and when power lands.',
        author: 'Matthew Silvester',
        role: 'Director, Meinhardt Thailand',
      },
      {
        text: 'We are less likely to see rationing; good policy and planning should mean we can avoid that.',
        author: 'M.K. Balaji',
        role: 'Strategic Advisory Board, ERRA',
      },
      {
        text: 'Across competing Southeast Asian markets, the policy trend is turning from rapid expansion to more selective, sustainability-linked data center growth.',
        author: 'Asst. Prof. Nondh Nuchmorn',
        role: 'Faculty of Economics, Thammasat University',
      },
    ],
  },
  {
    id: 'big-strategies',
    label: 'Big Strategies \u2014 Vision 2036',
    quotes: [
      {
        text: 'Predictable Policy is the biggest enabler to Predictable Energy.',
        author: 'Suthep Ratnabhas',
        role: 'EVAT',
      },
      {
        text: 'Electricity prices must reflect the market cost of consumption and generation.',
        author: 'Zixuan Guo',
        role: 'UNESCAP',
      },
      {
        text: 'Enhancing existing Power Assets is as important, if not more, than generating new assets.',
        author: 'Natat Thinaphong',
        role: 'Siemens Energy',
      },
      {
        text: 'Thailand does not lack low-carbon projects, it lacks aggregation into large projects.',
        author: 'Kriengkrai Chokelarptawee',
        role: 'Krungthai Bank',
      },
      {
        text: 'The biggest regret we will have in 2035 is if we do not incentivise pilot-scale projects now.',
        author: 'Assoc. Prof. Prawit Kongjan',
        role: 'Prince of Songkla University',
      },
    ],
  },
];

const galleryImages = [
  { src: '/Commitment Day/CD 26 Keynote_-_PEA.jpg', alt: 'Keynote address from PEA' },
  { src: '/Commitment Day/CD_26_-_Keynote_Arthit.jpg', alt: 'Keynote address by Khun Arthit Vechakij' },
  { src: '/Commitment Day/CD_26_-_Keynote_Vibikke.jpg', alt: 'Keynote address by Khun Vibeke Lyssand Leirvag' },
  { src: '/Commitment Day/CD 26 Cheer from Stage.jpg', alt: 'Cheering from the stage at Commitment Day 2026' },
  { src: '/Commitment Day/CD 26 Big_Cheers.jpg', alt: 'Guests cheering at the commitment ceremony' },
  { src: '/Commitment Day/CD 26 Panel_Martin.jpg', alt: 'Panel moderated by Martin Venzky-Stalling' },
  { src: '/Commitment Day/CD 26 Bob Announce Predictability Survey.jpg', alt: 'Bob Fox announcing the Predictability Survey' },
  { src: '/Commitment Day/CD 26 Panel_Bob.jpg', alt: 'Panel moderated by Bob Fox' },
  { src: '/Commitment Day/CD 26 Opening Dry Ice.jpg', alt: 'Opening with dry ice ceremony' },
  { src: '/Commitment Day/CD 26 Raise_a_toast.jpg', alt: 'Closing toast at Commitment Day 2026' },
  { src: '/Commitment Day/CD_26_-_Panel_Pai.jpg', alt: 'Panel discussion in progress' },
  { src: '/Commitment Day/CD_26_-_Stage_Wai.jpg', alt: 'On stage at Commitment Day 2026' },
];

const eventDetails = {
  date: '19 August 2026',
  venue: 'The Athenee Hotel, Bangkok',
  attendees: '398',
  phone: '+66 63 224 4664',
  email: 'info@psspowers.com',
};
---

<Layout
  title="Commitment Day 2026 — Predictable Energy, In the Room | PSS Powers"
  description="Commitment Day 2026 at The Athenee Hotel, Bangkok — 398 leaders from government, finance, industry and energy. Panels, keynotes, the Thailand Energy Predictability Survey launch, and the commitment ceremony."
  image={heroImage}
  type="article"
>
  <main class="pt-20">

    {/* ── Hero ─────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-slate-950">
      <div class="absolute inset-0">
        <img
          src={heroImage}
          alt="Commitment Day 2026 — attendees at The Athenee Hotel, Bangkok"
          class="w-full h-full object-cover opacity-30"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950/70 via-slate-950/85 to-slate-950"></div>
      </div>

      <div class="relative max-w-screen-2xl mx-auto px-6 lg:px-8 py-16 md:py-28">
        <div class="max-w-3xl" data-aos="fade-up">
          <p class="text-amber-400 text-sm font-semibold tracking-widest uppercase mb-4">
            PSS Powers presents
          </p>
          <h1 class="font-display text-4xl md:text-6xl font-bold text-white tracking-tight mb-4 leading-tight">
            Commitment Day 2026
          </h1>
          <p class="text-2xl text-emerald-400 font-display italic mb-6">
            Predictable Energy, In the Room
          </p>

          <p class="text-lg text-slate-300 leading-relaxed mb-3">
            {eventDetails.date} · {eventDetails.venue}
          </p>

          <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl">
            On 19 August, PSS Powers convened Commitment Day 2026 — a gathering of {eventDetails.attendees} leaders from government, finance, industry, and energy, built around a single premise: predictability, not just growth, is now the scarce resource in Thailand's energy system.
          </p>

          <div class="flex flex-wrap gap-3">
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-sm font-medium">
              {eventDetails.attendees} leaders in the room
            </span>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-sm font-medium">
              4 panels · 3 keynotes · 7-min tech updates
            </span>
          </div>
        </div>
      </div>
    </section>

    {/* ── Keynote Speakers ─────────────────────────────────── */}
    <section class="py-16 md:py-24 bg-slate-900">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="max-w-3xl mb-12" data-aos="fade-up">
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-10 bg-amber-400"></span>
            <p class="text-amber-400 text-xs font-bold tracking-[0.2em] uppercase">Keynote Addresses</p>
          </div>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight mb-5 leading-[1.1]">
            Three voices framing the question.
          </h2>
          <p class="text-slate-400 text-lg leading-relaxed max-w-2xl">
            How does Thailand build an energy system its businesses can actually plan around? Three keynote speakers framed the policy, grid, and private-sector dimensions of that single question.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6" data-aos="fade-up" data-aos-delay="100">
          {keynotes.map((k, i) => (
            <div class="group rounded-2xl p-6 bg-slate-950 border border-slate-800 hover:border-amber-500/40 transition-colors">
              <div class="flex items-center gap-4">
                <span class="w-12 h-12 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center flex-shrink-0 text-amber-400 font-display font-bold text-lg">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <p class="text-white font-semibold leading-tight">{k.name}</p>
                  <p class="text-slate-500 text-sm mt-1">{k.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── The Panels ───────────────────────────────────────── */}
    <section class="py-12 md:py-16">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-10" data-aos="fade-up">
          <p class="text-emerald-400 text-sm font-semibold tracking-widest uppercase mb-3">The Panels</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight">Four conversations. One room.</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6" data-aos="fade-up" data-aos-delay="100">
          {sessions.map((session) => (
            <div class="glass rounded-2xl overflow-hidden border-l-4 border-emerald-500 project-card">
              <div class="relative">
                <OptimizedImage
                  src={session.faceImage}
                  alt={`${session.title} — panellists`}
                  aspectRatio="1:1"
                  fit="contain"
                  priority={sessions.indexOf(session) < 2}
                />
                <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-slate-950/80 to-transparent flex items-center justify-between">
                  <button
                    type="button"
                    class="text-emerald-400 text-xs font-medium hover:text-emerald-300 transition-colors flex items-center gap-1"
                    onclick={`openPoster('poster-${session.id}')`}
                    style="min-height: auto;"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    View full poster
                  </button>
                </div>
              </div>

              <div class="p-5">
                <p class="text-amber-400 text-xs font-semibold uppercase tracking-wider mb-2">{session.track}</p>
                <h3 class="font-display text-xl font-bold text-white tracking-tight mb-2 leading-tight">
                  {session.title}
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-4">{session.summary}</p>

                <details class="group mb-4">
                  <summary class="cursor-pointer text-emerald-400 text-sm font-medium hover:text-emerald-300 transition-colors flex items-center gap-1 select-none">
                    <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    Moderator &amp; Panel
                  </summary>
                  <div class="mt-4 space-y-3">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Moderator</p>
                      <p class="text-white text-sm font-medium mb-3">{session.moderator}</p>

                      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Panel</p>
                      <div class="space-y-1.5">
                        {session.panel.map(member => (
                          <div class="flex items-baseline gap-2 text-sm">
                            <span class="text-emerald-400 font-semibold whitespace-nowrap">{member.org}</span>
                            <span class="text-slate-500">—</span>
                            <span class="text-slate-300">{member.person}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </details>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── 7-minute Tech Updates ────────────────────────────── */}
    <section class="py-12 md:py-16 bg-slate-900">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto" data-aos="fade-up">
          <div class="glass rounded-3xl overflow-hidden">
            <div class="grid md:grid-cols-2 gap-0">
              <div class="relative">
                <OptimizedImage
                  src={techUpdate.faceImage}
                  alt="7-Minute Tech Updates — speakers"
                  aspectRatio="1:1"
                  class="h-full"
                />
                <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-slate-950/80 to-transparent">
                  <button
                    type="button"
                    class="text-emerald-400 text-xs font-medium hover:text-emerald-300 transition-colors flex items-center gap-1"
                    onclick="openPoster('poster-tech')"
                    style="min-height: auto;"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    View full poster
                  </button>
                </div>
              </div>
              <div class="p-8 md:p-10">
                <p class="text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3">Rapid-fire showcases</p>
                <h3 class="font-display text-2xl font-bold text-white tracking-tight mb-3 leading-tight">
                  7-Minute Tech Updates
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-5">
                  A fast, wide-angle look at what's new across the sector — rapid-fire technology showcases with no corporate introductions.
                </p>
                <div class="flex flex-wrap gap-2">
                  {techUpdate.companies.map(company => (
                    <span class="px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-slate-200 text-xs font-medium">
                      {company}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Quotable Quotes ──────────────────────────────────── */}
    <section class="py-16 md:py-24" id="quotes-section">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-10" data-aos="fade-up">
          <p class="text-emerald-400 text-sm font-semibold tracking-widest uppercase mb-3">Quotable Quotes</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight">What the room heard.</h2>
        </div>

        <div class="max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="100">
          <div class="flex flex-wrap justify-center gap-2 mb-10 border-b border-slate-800 pb-1">
            {quoteTabs.map((tab, i) => (
              <button
                type="button"
                class:list={[
                  'px-5 py-2.5 text-sm font-semibold rounded-t-lg transition-colors border-b-2 -mb-1',
                  i === 0 ? 'active-quote-tab border-emerald-500 text-emerald-400' : 'border-transparent text-slate-400 hover:text-slate-200',
                ]}
                data-quote-tab={tab.id}
                style="min-height: auto;"
              >
                {tab.label}
              </button>
            ))}
          </div>

          {quoteTabs.map((tab, tabIndex) => (
            <div
              class:list={['quote-panel', tabIndex === 0 ? '' : 'hidden']}
              data-quote-panel={tab.id}
            >
              <div class:list={['grid gap-6', tab.quotes.length > 6 ? 'md:grid-cols-2' : 'md:grid-cols-2']}>
                {tab.quotes.map((q) => (
                  <div class:list={[
                    'glass rounded-2xl p-7 border-l-4',
                    q.featured ? 'border-amber-500 md:col-span-2' : 'border-emerald-500',
                  ]}>
                    <svg class:list={['w-8 h-8 mb-3', q.featured ? 'text-amber-500/30' : 'text-emerald-500/30']} fill="currentColor" viewBox="0 0 24 24"><path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" /></svg>
                    <p class:list={[
                      'text-slate-200 leading-relaxed font-display italic mb-4',
                      q.featured ? 'text-lg md:text-xl' : 'text-lg',
                    ]}>
                      {q.text}
                    </p>
                    <p class:list={['text-sm font-semibold', q.featured ? 'text-amber-400' : 'text-emerald-400']}>{q.author}</p>
                    {q.role && <p class="text-slate-500 text-xs mt-0.5">{q.role}</p>}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Thailand Energy Predictability Survey ────────────── */}
    <section class="py-16 md:py-24 bg-slate-900">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto" data-aos="fade-up">
          <div class="glass rounded-3xl overflow-hidden border border-emerald-500/20">
            <div class="h-1.5 bg-gradient-to-r from-emerald-400 via-emerald-500 to-emerald-700"></div>
            <div class="p-8 md:p-12">
              <div class="flex items-center gap-3 mb-5">
                <span class="relative flex h-3 w-3">
                  <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60 animate-ping"></span>
                  <span class="relative inline-flex h-3 w-3 rounded-full bg-emerald-400"></span>
                </span>
                <p class="text-emerald-400 text-xs font-bold tracking-[0.16em] uppercase">New Initiative Launched</p>
              </div>

              <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight mb-5 leading-[1.1]">
                The Thailand Energy Predictability Survey
              </h2>

              <p class="text-slate-300 text-lg leading-relaxed mb-5">
                A new initiative with JFCCT — the first attempt to measure, on a recurring annual basis, how predictable Thailand's cost, availability, and regulation of energy actually feels to the businesses investing in it.
              </p>

              <p class="text-slate-400 text-sm leading-relaxed mb-6">
                We shall support and seek more partners to expand the survey across the region. Scored across five dimensions including price predictability, grid access, and regulatory certainty.
              </p>

              <a
                href="/contact"
                class="inline-flex items-center justify-center gap-x-2 px-7 py-3 bg-amber-500 hover:bg-amber-400 transition-colors text-slate-950 font-bold rounded-full text-sm"
                style="min-height: auto;"
              >
                Become a partner
