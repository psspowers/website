---
import Layout from '../layouts/Layout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import PosterModal from '../components/PosterModal.astro';

const registrationUrl = 'https://www.zipeventapp.com/e/PSS-Commitment-Day-2026';
const eventDate = '2026-08-19';
const today = new Date('2026-08-18T00:00:00Z');
const eventDay = new Date(eventDate + 'T00:00:00Z');
const daysUntil = Math.ceil((eventDay.getTime() - today.getTime()) / 86400000);

const heroImage = '/Commitment Day/5.1_-_Panel__Leader_+_Government_.jpg';

const sessions = [
  {
    id: 'session-1',
    time: '4:00 – 4:45 PM',
    round: 'Round 1',
    room: 'London 1',
    track: 'Data Center — Policy & Delivery',
    title: 'Can Thailand power the AI boom?',
    summary: 'A single 100 MW data-centre campus draws power on the scale of a Thai city. Can the grid, connection timelines and policy support growth at the speed now being proposed?',
    description:
      'Thailand is attracting major data-centre investment. A single 100 MW campus draws power on the scale of a Thai city. The question is whether the grid, the connection timelines and the policy environment can support that growth at the speed now being proposed.',
    question:
      'Can Thailand support rapid data-centre expansion without creating new risks for electricity reliability, affordability or the wider economy?',
    moderator: 'Bob Fox — Chair, Digital Economy & Policy Co-ordinator, JFCCT',
    panel: [
      { org: 'ERC', person: 'Dr. Chanchai Amornvipas' },
      { org: 'Thammasat University', person: 'Asst. Prof. Nondh Nuchmorn' },
      { org: 'ERRA', person: 'M.K. Balaji, Advisory Board' },
      { org: 'Deloitte', person: 'Dr. Bordin Vongvitayapirom, CoE Head, Sustainability & Energy' },
    ],
    faceImage: '/Commitment Day/5.1.1_-_Panel__Leader_+_Government_.png',
    posterImage: '/Commitment Day/5.1_-_Panel__Leader_+_Government_.jpg',
    fillPct: 100,
    fillLabel: '100% Full',
    fillCategory: 'Data Center',
    fillNickname: 'Gov & Policy',
  },
  {
    id: 'session-2',
    time: '4:00 – 4:45 PM',
    round: 'Round 1',
    room: 'London 3',
    track: 'Energy — Now & Next',
    title: 'What can companies implement today?',
    summary: 'BESS and peak management, industrial efficiency, cooling, energy recovery and practical renewables. Real projects, real economics, real payback periods.',
    description:
      'Most of the energy debate is about future policy. This session is about what is already available — BESS and peak management, industrial efficiency, cooling, rotating-equipment optimisation, energy recovery and practical renewables. Real projects, real economics, real payback periods.',
    question:
      'If energy policy does not change for the next 12 months, what can companies implement today to materially reduce cost, emissions and operational risk?',
    moderator: 'Natagorn Kawsuay — Head of Business Development & Strategic Partnerships, PSS Powers',
    panel: [
      { org: 'Thai Renewable Energy (RE100) Association', person: 'Arthit Vechakij, President' },
      { org: 'EEC Engineering Network', person: 'Annop Kingkachee, Managing Director' },
      { org: 'Huawei (Thailand)', person: 'Patipan Kalvibool, Chief Technology Officer' },
      { org: 'PSS Group', person: 'Karan Yamdagni, CEO' },
      { org: 'PCS Thailand', person: 'Ibrahim Kocagoz, Director, Engineering Solutions' },
    ],
    faceImage: '/Commitment Day/5.2.1_-_Panel__Quick_Win_Technology_.png',
    posterImage: '/Commitment Day/5.2_-_Panel__Quick_Win_Technology_.jpg',
    fillPct: 81,
    fillLabel: '81% Full',
    fillCategory: 'Energy',
    fillNickname: 'Quick Win w RE',
  },
  {
    id: 'session-3',
    time: '5:00 – 5:45 PM',
    round: 'Round 2',
    room: 'London 1',
    track: 'Data Center — Policy & Delivery',
    title: 'Can we really build it in 12 months?',
    summary: 'Projects are expected to move from concept to operational readiness inside a year — while managing design changes, long-lead equipment, testing and commissioning.',
    description:
      'Projects are increasingly expected to move from concept to operational readiness inside a year — while managing design changes, power infrastructure, long-lead equipment, multiple contractors, testing and commissioning. This session deals with the execution reality, not the ambition.',
    question:
      'Can Thailand reliably deliver mega-scale data centres in 12 months — and what must change in engineering, procurement, construction and decision-making to make that possible?',
    moderator: 'Bob Fox — Chair, Digital Economy & Policy Co-ordinator, JFCCT',
    panel: [
      { org: 'Meinhardt (Thailand)', person: 'Matthew Silvester, Director' },
      { org: 'JLL', person: 'Chailai van Kampen, Head of Data Centres, Industrial & Logistics' },
      { org: 'Siemens (Thailand)', person: 'Ross Conlan, CEO & President' },
      { org: 'Asia Pacific Data Center Association (APDCA)', person: 'Speaker to be confirmed' },
    ],
    faceImage: '/Commitment Day/5.3.1_-_Panel__Engg_+_EPC_+_Consult_.png',
    posterImage: '/Commitment Day/5.3_-_Panel__Engg_+_EPC_+_Consult_.jpg',
    fillPct: 100,
    fillLabel: '100% Full',
    fillCategory: 'Data Center',
    fillNickname: 'DC in 12 Months',
  },
  {
    id: 'session-4',
    time: '5:00 – 5:45 PM',
    round: 'Round 2',
    room: 'London 3',
    track: 'Energy — Now & Next',
    title: 'What should Thailand invest in now?',
    summary: 'Grid modernisation, generation and storage, LNG and fuel security, transport decarbonisation. Capital and time are limited — this panel will prioritise, on the record.',
    description:
      'Grid modernisation. Generation and storage. LNG and fuel security. Transport decarbonisation. Power-plant modernisation. Hydrogen. Capital and time are both limited — so rather than discussing every option, this panel will be asked to prioritise, on the record.',
    question:
      'If Thailand has limited capital and limited time, which strategic energy investments should it prioritise now?',
    moderator: 'Martin Venzky-Stalling — Chair, Sustainable Development Committee, JFCCT',
    panel: [
      { org: 'Prince of Songkla University', person: 'Assoc. Prof. Prawit Kongjan' },
      { org: 'Maxion Wheels', person: 'Sutheep Ratnabhas, President-Asia; VP, EVAT' },
      { org: 'UNESCAP', person: 'Zixuan Guo, Power Policy & Planning' },
      { org: 'Siemens Energy', person: 'Natat Thinaphong, Sales Director' },
      { org: 'Krungthai Bank', person: 'Kriengkrai Chokelarptawee, SVP, Markets Solutions' },
    ],
    faceImage: '/Commitment Day/5.4.1_-_Panel__Strategic_Initiative_.png',
    posterImage: '/Commitment Day/5.4_-_Panel__Strategic_Initiative_.jpg',
    fillPct: 86,
    fillLabel: '86% Full',
    fillCategory: 'Energy',
    fillNickname: 'Big Strategies',
  },
];

const techUpdate = {
  faceImage: '/Commitment Day/5.5.1_-_7_Mins_Tech_Update_.png',
  posterImage: '/Commitment Day/5.5_-_7_Mins_Tech_Update_.png',
  companies: ['Huawei', 'Integra RE', 'Atmoce', 'Jinko Solar', 'UL', 'Envision', 'PSS'],
};

const availabilityGroups = [
  {
    label: 'Data Center',
    items: [
      { fillPct: 100, fillNickname: 'Gov & Policy' },
      { fillPct: 100, fillNickname: 'DC in 12 Months' },
    ],
  },
  {
    label: 'Energy',
    items: [
      { fillPct: 81, fillNickname: 'Quick Win w RE' },
      { fillPct: 86, fillNickname: 'Big Strategies' },
    ],
  },
  {
    label: 'Tech Update',
    items: [
      { fillPct: 66, fillNickname: 'Fun w Tech' },
      { fillPct: 75, fillNickname: 'Fun w Tech' },
    ],
  },
];

const manifest = [
  {
    label: 'Policy & Regulation',
    orgs: ['ERC', 'ERRA', 'UN ESCAP', 'RE100', 'EVAT', 'APDCA', 'JFCCT'],
  },
  {
    label: 'Capital & Finance',
    orgs: ['Krungthai Bank', 'I Squared', 'Berde PSS'],
  },
  {
    label: 'Engineering, EPC & Advisory',
    orgs: ['Meinhardt', 'ISTARI', 'JLL', 'Deloitte', 'PCS', 'EEC', 'PSS Group'],
  },
  {
    label: 'Energy & Technology',
    orgs: ['Siemens Energy', 'Huawei', 'Jinko Solar', 'Integra RE', 'Atmoce', 'UL', 'Watts'],
  },
  {
    label: 'Research & Academia',
    orgs: ['Thammasat University', 'Prince of Songkla University'],
  },
  {
    label: 'International Business',
    orgs: ['Seven chambers of commerce'],
  },
];

const audienceTypes = [
  'Government & policy makers',
  'Data-centre operators & investors',
  'Manufacturers & industrial estates',
  'Engineering & construction leaders',
  'Renewable developers & utilities',
  'Investors, banks & infrastructure funds',
];

const sponsors = ['I Squared', 'Berde Renewables', 'Y Cube'];
const supporters = [
  'JFCCT',
  'Irish Thai Chamber of Commerce',
  'Thai-Finnish Chamber of Commerce',
  'Thai-Swedish Chamber of Commerce',
  'Netherlands-Thai Chamber of Commerce',
  'New Zealand Chamber of Commerce',
  'British Chamber of Commerce',
  'RE100 Thailand',
  'IIT Alumni',
];

const eventDetails = {
  date: 'Wednesday 19 August 2026',
  venue: 'The Athenee Hotel, Bangkok',
  registrationStart: '3:00 PM',
  phone: '+66 63 224 4664',
  email: 'info@psspowers.com',
  mapsUrl: 'https://maps.google.com/?q=The+Athenee+Hotel+Bangkok',
};
---

<Layout
  title="Commitment Day 2026 — Predictable Energy | PSS Powers"
  description="Commitment Day 2026 at The Athenee Hotel, Bangkok — Wednesday 19 August 2026. Government, investors, developers and energy leaders in one room. By invitation. Register before 17 August."
  image={heroImage}
  type="article"
>
  <main class="pt-20">

    {/* ── Hero ─────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-slate-950">
      <div class="absolute inset-0">
        <img
          src="/News_Images/Commitment_Day_2025.jpeg"
          alt="Commitment Day 2025 event photography"
          class="w-full h-full object-cover opacity-25"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/90 to-slate-950"></div>
      </div>

      <div class="relative max-w-screen-2xl mx-auto px-6 lg:px-8 py-16 md:py-24">
        <div class="grid lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-start">
          {/* Left: Event details */}
          <div data-aos="fade-up">
            <p class="text-amber-400 text-sm font-semibold tracking-widest uppercase mb-4">
              PSS Powers presents
            </p>
            <h1 class="font-display text-4xl md:text-6xl font-bold text-white tracking-tight mb-4 leading-tight">
              Commitment Day 2026
            </h1>
            <p class="text-2xl text-emerald-400 font-display italic mb-6">
              Predictable Energy
            </p>

            <p class="text-lg text-slate-300 leading-relaxed mb-6 max-w-2xl">
              Thailand's energy conversation is usually held in separate rooms. On 19 August, they are all in one place.
            </p>

            <p class="text-slate-400 italic font-display text-lg leading-snug border-l-2 border-emerald-500/40 pl-4 mb-8 max-w-lg">
              The panels are worth your afternoon. The room is worth your evening.
            </p>

            {/* Key facts */}
            <div class="flex flex-col gap-3 mb-8">
              <div class="flex items-center gap-3 text-slate-200">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                <span>{eventDetails.date}</span>
              </div>
              <div class="flex items-center gap-3 text-slate-200">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <span>{eventDetails.venue}</span>
              </div>
              <div class="flex items-center gap-3 text-slate-200">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>Registration from {eventDetails.registrationStart}</span>
              </div>
            </div>

            {/* Registration CTA — primary */}
            <a
              href={registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-x-2 px-8 py-4 bg-emerald-500 hover:bg-emerald-600 transition-colors text-slate-950 font-bold rounded-full text-base mb-5"
              style="min-height: auto;"
            >
              Register &amp; choose your sessions
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>

            {/* Urgency / status badges */}
            <div class="flex flex-wrap gap-3">
              {daysUntil > 1 && (
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-sm font-medium">
                  <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                  {daysUntil} day{daysUntil !== 1 ? 's' : ''} to go
                </span>
              )}
              {daysUntil === 1 && (
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/15 border border-amber-500/40 text-amber-300 text-sm font-bold">
                  <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                  Tomorrow — 19 August
                </span>
              )}
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/10 border border-red-500/30 text-red-300 text-sm font-medium">
                Final registration deadline — today
              </span>
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/80 border border-slate-700 text-slate-300 text-sm font-medium">
                By invitation only
              </span>
            </div>
          </div>

          {/* Right: Seats filling dials */}
          <div class="lg:w-[480px]" data-aos="fade-up" data-aos-delay="200">
            <div class="glass rounded-2xl p-7">
              <h2 class="text-white font-display text-xl font-bold mb-1">Seats are filling fast</h2>
              <p class="text-slate-500 text-xs mb-6 leading-relaxed">
                Entry by QR code. Last year, some without a chosen session found their room full.
              </p>

              <div class="grid grid-cols-3 gap-x-0">
                {availabilityGroups.map((group, gi) => (
                  <div class={`flex flex-col items-center px-2 ${gi > 0 ? 'border-l border-slate-700/50' : ''}`}>
                    <p class="text-[11px] font-bold uppercase tracking-wider text-amber-400 mb-4 leading-tight text-center">{group.label}</p>
                    <div class="space-y-5">
                      {group.items.map(s => (
                        <div class="flex flex-col items-center text-center">
                          <div class={`relative inline-flex items-center justify-center w-20 h-20 mb-1 ${s.fillPct >= 100 ? 'animate-pulse' : ''}`}>
                            <svg class="w-20 h-20 -rotate-90" viewBox="0 0 64 64">
                              <circle cx="32" cy="32" r="27" fill="none" stroke="rgb(30 41 59)" stroke-width="4" />
                              <circle
                                cx="32" cy="32" r="27" fill="none"
                                stroke={s.fillPct >= 100 ? 'rgb(239 68 68)' : 'rgb(16 185 129)'} stroke-width="4"
                                stroke-dasharray={2 * Math.PI * 27}
                                stroke-dashoffset={2 * Math.PI * 27 * (1 - s.fillPct / 100)}
                                stroke-linecap="round"
                                class="transition-all duration-1000"
                              />
                            </svg>
                            <span class={`absolute text-sm font-bold ${s.fillPct >= 100 ? 'text-red-400' : 'text-white'}`}>{s.fillPct}%</span>
                          </div>
                          {s.fillPct >= 100 ? (
                            <p class="text-[10px] text-red-400 uppercase tracking-wider leading-tight font-bold">Full — Join waitlist</p>
                          ) : (
                            <p class="text-[10px] text-slate-500 uppercase tracking-wider leading-tight">Full</p>
                          )}
                          <p class={`mt-1 text-[11px] font-medium leading-tight ${s.fillPct >= 100 ? 'text-red-300' : 'text-emerald-300'}`}>{s.fillNickname}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              <a
                href={registrationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 flex items-center justify-center gap-x-2 w-full px-4 py-3 bg-emerald-500 hover:bg-emerald-600 transition-colors text-slate-950 font-bold rounded-full text-sm"
                style="min-height: auto;"
              >
                Register today for tomorrow
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Who Is in the Room + Special Announcement ────────── */}
    <section class="relative overflow-hidden py-16 md:py-24 bg-slate-900">
      <div class="absolute inset-0 pointer-events-none opacity-40" style="background: radial-gradient(circle at 82% 38%, rgba(245, 158, 11, 0.12), transparent 34%), radial-gradient(circle at 12% 70%, rgba(16, 185, 129, 0.08), transparent 30%);"></div>
      <div class="relative max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="max-w-3xl mb-12" data-aos="fade-up">
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-10 bg-emerald-400"></span>
            <p class="text-emerald-400 text-xs font-bold tracking-[0.2em] uppercase">Confirmed in the room</p>
          </div>
          <h2 class="font-display text-4xl md:text-5xl font-bold text-white tracking-tight mb-5 leading-[1.1]">
            The room is the story.
          </h2>
          <p class="text-slate-400 text-lg md:text-xl leading-relaxed max-w-2xl">
            Government, developers, investors, banks and the companies paying the electricity bill — the people who buy the power, build the assets and finance both.
          </p>
        </div>

        <div class="grid lg:grid-cols-[1.08fr_0.92fr] gap-8 xl:gap-12 items-stretch">
          {/* Left: Confirmed organisations */}
          <div class="glass rounded-2xl p-6 md:p-8" data-aos="fade-up" data-aos-delay="100">
            <div class="flex items-end justify-between gap-4 pb-5 mb-1 border-b border-slate-800">
              <div>
                <p class="text-white font-display text-xl font-bold">Who is represented in the Panels</p>
                <p class="text-slate-500 text-sm mt-1">Six sectors. One executive room.</p>
              </div>
              <span class="text-emerald-400 font-display text-3xl font-bold leading-none">06</span>
            </div>

            <div class="divide-y divide-slate-800">
              {manifest.map((cat, i) => (
                <div class="group flex gap-4 py-4 first:pt-5 last:pb-2">
                  <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold flex items-center justify-center transition-colors group-hover:bg-emerald-500/20">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0">
                    <p class="text-emerald-400 text-xs font-bold uppercase tracking-wider mb-1">{cat.label}</p>
                    <p class="text-slate-300 text-sm leading-relaxed">{cat.orgs.join(' · ')}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-6 pt-5 border-t border-slate-800">
              <p class="text-slate-500 text-xs leading-relaxed mb-3">
                An executive-scale event, deliberately kept small. The value of the evening is the density of the room.
              </p>
              <div class="flex flex-wrap gap-2">
                {audienceTypes.map(a => (
                  <span class="px-2.5 py-1 rounded-md bg-slate-800/70 border border-slate-700 text-slate-400 text-[11px]">{a}</span>
                ))}
              </div>
            </div>
          </div>

          {/* Right: Special Announcement — Keynote Speakers */}
          <div class="relative" data-aos="fade-up" data-aos-delay="200">
            <div class="absolute -inset-px rounded-2xl bg-gradient-to-br from-amber-400/50 via-amber-500/10 to-transparent opacity-80"></div>
            <div class="relative h-full rounded-2xl overflow-hidden bg-slate-950 border border-amber-500/30">
              <div class="h-1.5 bg-gradient-to-r from-amber-300 via-amber-500 to-amber-700"></div>
              <div class="p-7 md:p-9">
                <div class="flex items-center justify-between gap-4 mb-7">
                  <div class="flex items-center gap-3">
                    <span class="relative flex h-3 w-3">
                      <span class="absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-60 animate-ping"></span>
                      <span class="relative inline-flex h-3 w-3 rounded-full bg-amber-400"></span>
                    </span>
                    <p class="text-amber-400 text-xs font-bold tracking-[0.16em] uppercase">Special announcement</p>
                  </div>
                  <span class="text-amber-500/70 font-display text-4xl font-bold leading-none">03</span>
                </div>

                <p class="text-slate-500 text-xs font-semibold tracking-widest uppercase mb-3">For the evening session</p>
                <h3 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight mb-4 leading-[1.08]">
                  Three voices shaping the conversation.
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-7">
                  We're honoured to welcome the following keynote speakers to the room tomorrow evening.
                </p>

                <div class="space-y-2.5 mb-6">
                  <div class="group rounded-xl p-4 bg-slate-900 border border-slate-800 hover:border-amber-500/40 transition-colors flex items-center gap-4">
                    <span class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center flex-shrink-0 text-amber-400 font-display font-bold">01</span>
                    <div>
                      <p class="text-white font-semibold leading-tight">Khun Sanphet Bunyamanee</p>
                      <p class="text-slate-500 text-sm mt-0.5">Deputy Minister of Transport*</p>
                    </div>
                  </div>
                  <div class="group rounded-xl p-4 bg-slate-900 border border-slate-800 hover:border-amber-500/40 transition-colors flex items-center gap-4">
                    <span class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center flex-shrink-0 text-amber-400 font-display font-bold">02</span>
                    <div>
                      <p class="text-white font-semibold leading-tight">Khun Somchai Songsiri</p>
                      <p class="text-slate-500 text-sm mt-0.5">Deputy Governor, PEA</p>
                    </div>
                  </div>
                  <div class="group rounded-xl p-4 bg-slate-900 border border-slate-800 hover:border-amber-500/40 transition-colors flex items-center gap-4">
                    <span class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center flex-shrink-0 text-amber-400 font-display font-bold">03</span>
                    <div>
                      <p class="text-white font-semibold leading-tight">Khun Arthit Vechakij</p>
                      <p class="text-slate-500 text-sm mt-0.5">President, RE100</p>
                    </div>
                  </div>
                </div>

                <p class="text-slate-600 text-xs italic leading-relaxed mb-6">
                  *Invitation accepted, pending last minute confirmation.
                </p>

                <a
                  href={registrationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center justify-between gap-x-4 px-5 py-3.5 bg-amber-500 hover:bg-amber-400 transition-colors text-slate-950 font-bold rounded-xl text-sm w-full"
                  style="min-height: auto;"
