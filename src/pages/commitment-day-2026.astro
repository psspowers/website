---
import Layout from '../layouts/Layout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

const registrationUrl = 'https://www.zipeventapp.com/e/PSS-Commitment-Day-2026';
const eventDate = '2026-08-19';
const today = new Date('2026-08-14T00:00:00Z');
const eventDay = new Date(eventDate + 'T00:00:00Z');
const daysUntil = Math.ceil((eventDay.getTime() - today.getTime()) / 86400000);

const heroImage = '/Commitment Day/5.1_-_Panel__Leader_+_Government_.jpg';

const sessions = [
  {
    time: '4:00 – 4:45 PM',
    round: 'Round 1',
    room: 'London 1',
    track: 'Data Center — Policy & Delivery',
    title: 'Can Thailand power the AI boom?',
    description:
      'Thailand is attracting major data-centre investment. A single 100 MW campus draws power on the scale of a Thai city. The question is whether the grid, the connection timelines and the policy environment can support that growth at the speed now being proposed.',
    question:
      'Can Thailand support rapid data-centre expansion without creating new risks for electricity reliability, affordability or the wider economy?',
    moderator: 'Bob Fox — Chair, Digital Economy & Policy Co-ordinator, JFCCT',
    panel: [
      { org: 'ERC', person: 'Dr. Chanchai Amornvipas' },
      { org: 'Thammasat University', person: 'Asst. Prof. Nondh Nuchmorn' },
      { org: 'ERRA', person: 'M.K. Balaji, Advisory Board' },
      { org: 'Deloitte', person: 'Dr. Bordin Vongvitayapirom, CoE Head, Sustainability & Energy' },
    ],
    image: '/Commitment Day/5.1_-_Panel__Leader_+_Government_.jpg',
  },
  {
    time: '4:00 – 4:45 PM',
    round: 'Round 1',
    room: 'London 3',
    track: 'Energy — Now & Next',
    title: 'What can companies implement today?',
    description:
      'Most of the energy debate is about future policy. This session is about what is already available — BESS and peak management, industrial efficiency, cooling, rotating-equipment optimisation, energy recovery and practical renewables. Real projects, real economics, real payback periods.',
    question:
      'If energy policy does not change for the next 12 months, what can companies implement today to materially reduce cost, emissions and operational risk?',
    moderator: 'Natagorn Kawsuay — Head of Business Development & Strategic Partnerships, PSS Powers',
    panel: [
      { org: 'Thai Renewable Energy (RE100) Association', person: 'Arthit Vechakij, President' },
      { org: 'EEC Engineering Network', person: 'Annop Kingkachee, Managing Director' },
      { org: 'Huawei (Thailand)', person: 'Patipan Kalvibool, Chief Technology Officer' },
      { org: 'PSS Group', person: 'Karan Yamdagni, CEO' },
      { org: 'PCS Thailand', person: 'Ibrahim Kocagoz, Director, Engineering Solutions' },
    ],
    image: '/Commitment Day/5.2_-_Panel__Quick_Win_Technology_.jpg',
  },
  {
    time: '5:00 – 5:45 PM',
    round: 'Round 2',
    room: 'London 1',
    track: 'Data Center — Policy & Delivery',
    title: 'Can we really build it in 12 months?',
    description:
      'Projects are increasingly expected to move from concept to operational readiness inside a year — while managing design changes, power infrastructure, long-lead equipment, multiple contractors, testing and commissioning. This session deals with the execution reality, not the ambition.',
    question:
      'Can Thailand reliably deliver mega-scale data centres in 12 months — and what must change in engineering, procurement, construction and decision-making to make that possible?',
    moderator: 'Bob Fox — Chair, Digital Economy & Policy Co-ordinator, JFCCT',
    panel: [
      { org: 'Meinhardt (Thailand)', person: 'Matthew Silvester, Director' },
      { org: 'JLL', person: 'Chailai van Kampen, Head of Data Centres, Industrial & Logistics' },
      { org: 'Siemens (Thailand)', person: 'Ross Conlan, CEO & President' },
      { org: 'Asia Pacific Data Center Association (APDCA)', person: 'Speaker to be confirmed' },
    ],
    image: '/Commitment Day/5.3_-_Panel__Engg_+_EPC_+_Consult_.jpg',
  },
  {
    time: '5:00 – 5:45 PM',
    round: 'Round 2',
    room: 'London 3',
    track: 'Energy — Now & Next',
    title: 'What should Thailand invest in now?',
    description:
      'Grid modernisation. Generation and storage. LNG and fuel security. Transport decarbonisation. Power-plant modernisation. Hydrogen. Capital and time are both limited — so rather than discussing every option, this panel will be asked to prioritise, on the record.',
    question:
      'If Thailand has limited capital and limited time, which strategic energy investments should it prioritise now?',
    moderator: 'Martin Venzky-Stalling — Chair, Sustainable Development Committee, JFCCT',
    panel: [
      { org: 'Prince of Songkla University', person: 'Assoc. Prof. Prawit Kongjan' },
      { org: 'Maxion Wheels', person: 'Sutheep Ratnabhas, President-Asia; VP, EVAT' },
      { org: 'UNESCAP', person: 'Zixuan Guo, Power Policy & Planning' },
      { org: 'Siemens Energy', person: 'Natat Thinaphong, Sales Director' },
      { org: 'Krungthai Bank', person: 'Kriengkrai Chokelarptawee, SVP, Markets Solutions' },
    ],
    image: '/Commitment Day/5.4_-_Panel__Strategic_Initiative_.jpg',
  },
];

const techUpdateCompanies = [
  'Huawei',
  'Integra RE',
  'Atmoce',
  'Jinko Solar',
  'UL',
  'Envision',
  'PSS',
];

const sponsors = ['I Squared', 'Berde Renewables', 'Y Cube'];
const supporters = [
  'JFCCT',
  'Irish Thai Chamber of Commerce',
  'Thai-Finnish Chamber of Commerce',
  'Thai-Swedish Chamber of Commerce',
  'Netherlands-Thai Chamber of Commerce',
  'New Zealand Chamber of Commerce',
  'British Chamber of Commerce',
  'RE100 Thailand',
  'IIT Alumni',
];

const eventDetails = {
  date: 'Wednesday 19 August 2026',
  venue: 'The Athenee Hotel, Bangkok',
  registrationStart: '3:00 PM',
  closingDate: '18 August 2026',
  phone: '+66 63 224 4664',
  email: 'info@psspowers.com',
  mapsUrl: 'https://maps.google.com/?q=The+Athenee+Hotel+Bangkok',
};
---

<Layout
  title="Commitment Day 2026 — Choose Your Conversation | PSS Powers"
  description="Commitment Day 2026 at The Athenee Hotel, Bangkok — Wednesday 19 August 2026. Four focused discussions on data centres, practical energy solutions, project delivery and Thailand's long-term strategy. By invitation. Register and choose your sessions."
  image={heroImage}
  type="article"
>
  <main class="pt-20">

    {/* ── Hero ─────────────────────────────────────────────── */}
    <section class="relative overflow-hidden bg-slate-950">
      <div class="absolute inset-0">
        <img
          src="/News_Images/Commitment_Day_2025.jpeg"
          alt="Commitment Day 2025 event photography"
          class="w-full h-full object-cover opacity-25"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-970/90 to-slate-950"></div>
      </div>

      <div class="relative max-w-screen-2xl mx-auto px-6 lg:px-8 py-16 md:py-24">
        <div class="max-w-3xl" data-aos="fade-up">
          <p class="text-amber-400 text-sm font-semibold tracking-widest uppercase mb-4">
            PSS Powers presents
          </p>
          <h1 class="font-display text-4xl md:text-6xl font-bold text-white tracking-tight mb-4 leading-tight">
            Commitment Day 2026
          </h1>
          <p class="text-2xl text-emerald-400 font-display italic mb-8">
            Predictable Energy
          </p>

          {/* Key facts */}
          <div class="flex flex-col gap-3 mb-10">
            <div class="flex items-center gap-3 text-slate-200">
              <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              <span>{eventDetails.date}</span>
            </div>
            <div class="flex items-center gap-3 text-slate-200">
              <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span>{eventDetails.venue}</span>
            </div>
            <div class="flex items-center gap-3 text-slate-200">
              <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span>Registration from {eventDetails.registrationStart}</span>
            </div>
          </div>

          {/* Registration CTA — primary */}
          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <a
              href={registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-x-2 px-8 py-4 bg-emerald-500 hover:bg-emerald-600 transition-colors text-slate-950 font-bold rounded-full text-base"
              style="min-height: auto;"
            >
              Register &amp; choose your sessions
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <a
              href="#programme"
              class="inline-flex items-center justify-center gap-x-2 px-8 py-4 border border-slate-600 hover:border-slate-400 text-slate-200 hover:text-white transition-colors rounded-full font-semibold text-base"
              style="min-height: auto;"
            >
              View session line-up
            </a>
          </div>

          {/* Urgency / status badges */}
          <div class="flex flex-wrap gap-3">
            {daysUntil > 0 && (
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-sm font-medium">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                {daysUntil} day{daysUntil !== 1 ? 's' : ''} to go
              </span>
            )}
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/80 border border-slate-700 text-slate-300 text-sm font-medium">
              By invitation only
            </span>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/80 border border-slate-700 text-slate-300 text-sm font-medium">
              Registration closes {eventDetails.closingDate}
            </span>
          </div>
        </div>
      </div>
    </section>

    {/* ── Quick schedule summary ────────────────────────────── */}
    <section class="py-16 md:py-20 bg-slate-900" id="programme">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center mb-12" data-aos="fade-up">
          <p class="text-emerald-400 text-sm font-semibold tracking-widest uppercase mb-3">The Format</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight mb-4">
            Choose your conversation.
          </h2>
          <p class="text-lg text-slate-400 leading-relaxed">
            Commitment Day 2026 is not a single-track conference. The afternoon runs as three parallel rooms across two rounds, built around four questions Thailand's businesses, investors and energy sector now have to answer. You choose one session per round — the two that matter most to your business.
          </p>
        </div>

        {/* Schedule timeline */}
        <div class="max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
          <div class="glass rounded-2xl p-6 md:p-8">
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-20 text-right">
                  <p class="text-emerald-400 font-bold text-lg">3:00</p>
                  <p class="text-slate-500 text-xs">PM</p>
                </div>
                <div class="flex-1 border-l-2 border-slate-700 pl-6">
                  <p class="text-white font-semibold">Registration opens</p>
                  <p class="text-slate-400 text-sm mt-1">Arrival and check-in at The Athenee Hotel</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-20 text-right">
                  <p class="text-emerald-400 font-bold text-lg">4:00</p>
                  <p class="text-slate-500 text-xs">PM</p>
                </div>
                <div class="flex-1 border-l-2 border-emerald-500 pl-6">
                  <p class="text-white font-semibold">Round 1 — Choose one session</p>
                  <p class="text-slate-400 text-sm mt-1">London 1: Data Center Policy &amp; Delivery · London 3: Energy Now &amp; Next</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-20 text-right">
                  <p class="text-emerald-400 font-bold text-lg">5:00</p>
                  <p class="text-slate-500 text-xs">PM</p>
                </div>
                <div class="flex-1 border-l-2 border-emerald-500 pl-6">
                  <p class="text-white font-semibold">Round 2 — Choose one session</p>
                  <p class="text-slate-400 text-sm mt-1">London 1: Data Center Policy &amp; Delivery · London 3: Energy Now &amp; Next</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-20 text-right">
                  <p class="text-emerald-400 font-bold text-lg">6:00</p>
                  <p class="text-slate-500 text-xs">PM</p>
                </div>
                <div class="flex-1 border-l-2 border-slate-700 pl-6">
                  <p class="text-white font-semibold">Plenary — all guests rejoin</p>
                  <p class="text-slate-400 text-sm mt-1">Leadership perspectives, commitment announcements, networking &amp; dinner</p>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-700/50">
              <div class="flex items-start gap-3 text-sm text-slate-400">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <p>
                  <span class="text-white font-semibold">Room China</span> runs 7-minute Tech Updates in both rounds, for those who prefer a faster format.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Who should attend ─────────────────────────────────── */}
    <section class="py-20">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div data-aos="fade-right">
            <p class="text-emerald-400 text-sm font-semibold tracking-widest uppercase mb-4">Who Should Attend</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight mb-6">
              Built for decision-makers across energy, infrastructure and policy
            </h2>
            <p class="text-slate-400 text-lg leading-relaxed mb-8">
              If you are responsible for energy strategy, project delivery, investment decisions, or policy in Thailand's energy and data-centre sector, this afternoon is designed for you.
            </p>
            <div class="grid sm:grid-cols-2 gap-3">
              {[
                'Business leaders & CEOs',
                'Energy & sustainability managers',
                'Data-centre operators & investors',
                'Engineering & EPC leaders',
                'Government & policy makers',
                'Investors & financiers',
              ].map(item => (
                <div class="flex items-center gap-2.5 text-slate-300 text-sm">
                  <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                  {item}
                </div>
              ))}
            </div>
          </div>

          <div class="glass rounded-3xl p-8" data-aos="fade-left">
            <h3 class="text-white font-semibold text-lg mb-6">Why attend?</h3>
            <div class="space-y-5">
              {[
                { heading: 'Practical, not theoretical', desc: 'Sessions focus on what companies can implement today and what Thailand should prioritise now — not future speculation.' },
                { heading: 'Direct access to leaders', desc: 'Engage with regulators, technology providers, engineering firms, investors and policy experts in one room.' },
                { heading: 'Choose what matters to you', desc: 'Two rounds, two choices — pick the conversations most relevant to your business and your role.' },
                { heading: 'Commitments, not just talk', desc: 'The evening plenary brings every conclusion back together — what can we do now, what must Thailand do next, what are we prepared to commit to.' },
              ].map(item => (
                <div class="flex gap-x-4">
                  <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  </div>
                  <div>
                    <p class="text-white font-semibold text-sm mb-1">{item.heading}</p>
                    <p class="text-slate-400 text-sm leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Session cards ─────────────────────────────────────── */}
    {sessions.map((session, index) => (
      <section class={`py-12 md:py-16 ${index % 2 === 0 ? 'bg-slate-900' : ''}`}>
        <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
          {index === 0 && (
            <div class="text-center mb-10" data-aos="fade-up">
              <p class="text-emerald-400 text-sm font-semibold tracking-widest uppercase mb-3">The Full Session Line-up</p>
              <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight">Four questions. Four conversations.</h2>
            </div>
          )}

          {index === 0 && (
            <div class="max-w-2xl mx-auto mb-12" data-aos="fade-up" data-aos-delay="100">
              <div class="glass rounded-xl p-4 flex items-center justify-center gap-3 text-center">
                <span class="text-emerald-400 font-bold text-sm uppercase tracking-wider">{sessions[0].round}</span>
                <span class="text-slate-500">·</span>
                <span class="text-slate-300 text-sm">{sessions[0].time}</span>
              </div>
            </div>
          )}

          {index === 2 && (
            <div class="max-w-2xl mx-auto mb-12" data-aos="fade-up">
              <div class="glass rounded-xl p-4 flex items-center justify-center gap-3 text-center">
                <span class="text-emerald-400 font-bold text-sm uppercase tracking-wider">{sessions[2].round}</span>
                <span class="text-slate-500">·</span>
                <span class="text-slate-300 text-sm">{sessions[2].time}</span>
              </div>
            </div>
          )}

          <div class={`grid lg:grid-cols-2 gap-10 items-center ${index % 2 !== 0 ? 'lg:[&>*:first-child]:order-2' : ''}`} data-aos="fade-up">
            {/* Session image */}
            <div class="glass rounded-2xl overflow-hidden">
              <OptimizedImage
                src={session.image}
                alt={`${session.title} — panel artwork`}
                aspectRatio="16:9"
                priority={index < 2}
              />
            </div>

            {/* Session content */}
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-4">
                <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs font-semibold uppercase tracking-wider">
                  {session.round}
                </span>
                <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-400 text-xs font-medium">
                  {session.time}
                </span>
                <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-400 text-xs font-medium">
                  Room {session.room}
                </span>
              </div>

              <p class="text-amber-400 text-xs font-semibold uppercase tracking-wider mb-2">{session.track}</p>
              <h3 class="font-display text-2xl md:text-3xl font-bold text-white tracking-tight mb-4 leading-tight">
                {session.title}
              </h3>
              <p class="text-slate-400 leading-relaxed mb-6">{session.description}</p>

              <div class="glass rounded-xl p-5 mb-6 border-l-4 border-emerald-500">
                <p class="text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2">The question on the table</p>
                <p class="text-slate-300 italic leading-relaxed">{session.question}</p>
              </div>

              {/* Moderator */}
              <div class="mb-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Moderator</p>
                <p class="text-white text-sm font-medium">{session.moderator}</p>
              </div>

              {/* Panel */}
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Panel</p>
                <div class="space-y-2">
                  {session.panel.map(member => (
                    <div class="flex items-baseline gap-2 text-sm">
                      <span class="text-emerald-400 font-semibold whitespace-nowrap">{member.org}</span>
                      <span class="text-slate-500">—</span>
                      <span class="text-slate-300">{member.person}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}

    {/* ── 7-minute tech updates ─────────────────────────────── */}
    <section class="py-16 md:py-20 bg-slate-900">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto" data-aos="fade-up">
          <div class="glass rounded-3xl overflow-hidden">
            <div class="grid md:grid-cols-5 gap-0">
              <div class="md:col-span-2">
                <OptimizedImage
                  src="/Commitment Day/5.5_-_7_Mins_Tech_Update_.png"
                  alt="7-Minute Tech Updates — Room China"
                  aspectRatio="16:9"
                  class="h-full"
                />
              </div>
              <div class="md:col-span-3 p-8 md:p-10">
                <p class="text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3">Room China · Both rounds</p>
                <h3 class="font-display text-2xl md:text-3xl font-bold text-white tracking-tight mb-4 leading-tight">
                  Prefer a faster format? 7-Minute Tech Updates
                </h3>
                <p class="text-slate-400 leading-relaxed mb-6">
                  Short, concise presentations with no corporate introductions, built around a single question:
                  <span class="text-emerald-300 italic"> what has changed in your technology in the last 12 months that an energy executive should know?</span>
                </p>
                <div class="flex flex-wrap gap-2">
                  {techUpdateCompanies.map(company => (
                    <span class="px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-200 text-sm font-medium">
                      {company}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Evening plenary ───────────────────────────────────── */}
    <section class="py-16 md:py-20 solar-gradient">
      <div class="max-w-screen-2xl mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center" data-aos="fade-up">
          <p class="text-emerald-400 text-sm font-semibold tracking-widest uppercase mb-4">6:00 PM onwards · Grand Hall</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight mb-6">
            Then we come back together.
          </h2>
