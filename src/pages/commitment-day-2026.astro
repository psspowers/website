  ))}
  <PosterModal id="poster-tech" src={techUpdate.posterImage} alt="7-Minute Tech Updates — full poster" />

  <script is:inline>
    function openPoster(modalId) {
      const el = document.getElementById(modalId);
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-poster-modal]').forEach((m) => {
          if (!m.classList.contains('hidden')) {
            m.classList.add('hidden');
            m.classList.remove('flex');
            document.body.style.overflow = '';
          }
        });
      }
    });

    document.querySelectorAll('[data-quote-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-quote-tab');
        document.querySelectorAll('[data-quote-tab]').forEach((b) => {
          b.classList.remove('active-quote-tab', 'border-emerald-500', 'text-emerald-400');
          b.classList.add('border-transparent', 'text-slate-400');
        });
        btn.classList.add('active-quote-tab', 'border-emerald-500', 'text-emerald-400');
        btn.classList.remove('border-transparent', 'text-slate-400');
        document.querySelectorAll('[data-quote-panel]').forEach((panel) => {
          if (panel.getAttribute('data-quote-panel') === tabId) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });
  </script>
