        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-x-2 w-full py-3.5 bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 transition-colors text-slate-950 font-bold rounded-full text-sm"
        style="min-height: auto;"
      >
        Register &amp; choose your sessions
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </main>

  {/* ── Poster Modals ─────────────────────────────────────── */}
  {sessions.map(s => (
    <PosterModal id={`poster-${s.id}`} src={s.posterImage} alt={`${s.title} — full poster`} />
  ))}
  <PosterModal id="poster-tech" src={techUpdate.posterImage} alt="7-Minute Tech Updates — full poster" />

  <script is:inline>
    function openPoster(modalId) {
      const el = document.getElementById(modalId);
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-poster-modal]').forEach((m) => {
          if (!m.classList.contains('hidden')) {
            m.classList.add('hidden');
            m.classList.remove('flex');
            document.body.style.overflow = '';
          }
        });
      }
    });
  </script>
</Layout>
